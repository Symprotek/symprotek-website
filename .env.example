# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.

# --- Contact form (required for the form to send) ---------------------------
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where website enquiries are delivered.
CONTACT_TO_EMAIL=sales@symprotek.com

# The "from" address. The domain must be verified in Resend before this will
# send. Until it is verified, leave this unset to fall back to Resend's
# onboarding@resend.dev sandbox address (which only delivers to your own
# account email).
CONTACT_FROM_EMAIL="Symprotek Website <noreply@symprotek.com>"

# --- Site ------------------------------------------------------------------
# Absolute base URL, used for canonical tags, Open Graph images, and sitemap.
NEXT_PUBLIC_SITE_URL=https://www.symprotek.com
